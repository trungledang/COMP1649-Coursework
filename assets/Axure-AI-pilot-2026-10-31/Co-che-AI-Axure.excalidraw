ntFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": false, "lineHeight": 1.25}, {"id": "axure-36", "type": "text", "x": 40, "y": 960, "width": 1290, "height": 32, "angle": 0, "strokeColor": "#6c757d", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "index": null, "roundness": null, "seed": 928551696, "version": 1, "versionNonce": 1567272783, "isDeleted": false, "boundElements": null, "updated": 1793440800000, "link": null, "locked": false, "text": "Lưu ý: MCP chính thức hiện chỉ đọc; bridge đang ghim theo Axure RP 11.0.0.4150.", "originalText": "Lưu ý: MCP chính thức hiện chỉ đọc; bridge đang ghim theo Axure RP 11.0.0.4150.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": false, "lineHeight": 1.25}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": null}, "files": {}}